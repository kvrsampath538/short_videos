# Required
ANTHROPIC_API_KEY=your_anthropic_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# Optional — if set, uses YouTube Data API v3 for more accurate saturation checks
# Get one at: https://console.cloud.google.com → Enable YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_api_key_here

# Required for image generation via Gemini Imagen
# Get one at: https://aistudio.google.com/app/apikey
GOOGLE_AI_STUDIO_API_KEY=your_google_ai_studio_key_here

# Royalty-free image search (optional but recommended — add at least one)
# Pixabay: free, no credit card — pixabay.com/api/docs
PIXABAY_API_KEY=your_pixabay_key_here
# Pexels: free, no credit card — pexels.com/api
PEXELS_API_KEY=your_pexels_key_here
